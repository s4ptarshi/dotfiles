#!/usr/bin/env bash
# open-gdocs: open a file from the bisynced ~/gdrive in Google Docs/Sheets/Slides.
# Falls back to OnlyOffice for files outside ~/gdrive.

set -u

file=$(realpath -- "${1:?usage: open-gdocs <file>}")
root=$HOME/gdrive

fallback() {
    notify-send -u normal "open-gdocs" "$1" 2>/dev/null
    exec flatpak run org.onlyoffice.desktopeditors "$file"
}

[[ $file == "$root"/* ]] || fallback "Not inside ~/gdrive, opening locally."

rel=${file#"$root"/}
dir=$(dirname -- "$rel")
[[ $dir == . ]] && dir=
name=$(basename -- "$rel")
id=$(rclone lsf --files-only --max-depth 1 --format ip --separator $'\t' "gdrive:/$dir" 2>/dev/null |
    awk -F'\t' -v n="$name" '$2 == n { print $1; exit }')

[[ -n $id ]] || fallback "Not found on Drive yet (sync pending?), opening locally."

case "${file,,}" in
*.doc | *.docx | *.odt | *.rtf) url="https://docs.google.com/document/d/$id/edit" ;;
*.xls | *.xlsx | *.ods | *.csv) url="https://docs.google.com/spreadsheets/d/$id/edit" ;;
*.ppt | *.pptx | *.odp) url="https://docs.google.com/presentation/d/$id/edit" ;;
*) url="https://drive.google.com/file/d/$id/view" ;;
esac

exec xdg-open "$url"
